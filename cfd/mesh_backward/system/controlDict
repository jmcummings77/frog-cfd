FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application simpleFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 0;
deltaT 1;
writeControl timeStep;
writeInterval 500;
purgeWrite 2;
writeFormat binary;
writePrecision 8;
timeFormat general;
runTimeModifiable true;

